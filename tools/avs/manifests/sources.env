DAVS2_URL=https://github.com/xatabhk/davs2-10bit.git
DAVS2_COMMIT=21d64c8f8e36af71fc7a488cd6f789c86cdd1200
# Third-party decoder patches: downloaded directly from their original repository.
NILAODA_URL=https://github.com/nilaoda/mpv-iina-avs.git
NILAODA_COMMIT=235721aa34ab61ab75ed5163191eb805ad1fe35b
# Reference matrix tables, sourced separately instead of bundling their data.
LIBCAVS_URL=https://github.com/xeonliu/libcavs.git
LIBCAVS_COMMIT=690fc4f3c4844b3d45b02c7250d8ca1e3031f1f6
# Optional, isolated x264 static build for systems without x264-devel.
X264_URL=https://github.com/mirror/x264.git
