         if (ret < 0)
             return ret;
     }
@@ -1959,10 +1972,45 @@ static int decode_pic(AVSContext *h)
 
     /* AWQ parameters and aec_enable end the header (tables 21, 22) */
     h->aec_enable = 0;
+    h->weighting_quant_flag = 0;
+    h->chroma_delta_cb = h->chroma_delta_cr = 0;
     if (h->profile == AV_PROFILE_CAVS_BROADCASTING) {
-        if (get_bits1(&h->gb)) { //weighting_quant_flag
-            avpriv_request_sample(h->avctx, "Adaptive weighted quantization");
-            return AVERROR_PATCHWELCOME;
+        h->weighting_quant_flag = get_bits1(&h->gb);
+        if (h->weighting_quant_flag) {
+            /* GB/T 20090.16-2016 Tables 21/22 and Clause 9.9. */
+            static const uint8_t wq_default[6] = {128, 98, 106, 116, 116, 128};
+            static const uint8_t wq_base1[6] = {135, 143, 143, 160, 160, 213};
+            static const uint8_t wq_base2[6] = {128, 98, 106, 116, 116, 128};
+            static const uint8_t model[3][64] = {
+#include "cavs_awq_models.inc"
+            };
+            uint8_t params[6];
+            int index, wq_model, i;
+            const uint8_t *base;
+
+            /* Broadcast bitstreams may set this reserved bit. */
+            skip_bits1(&h->gb);
+            if (!get_bits1(&h->gb)) { //chroma_quant_parameter_disable
+                h->chroma_delta_cb = get_se_golomb(&h->gb);
+                h->chroma_delta_cr = get_se_golomb(&h->gb);
+                if (h->chroma_delta_cb < -16 || h->chroma_delta_cb > 16 ||
+                    h->chroma_delta_cr < -16 || h->chroma_delta_cr > 16)
+                    return AVERROR_INVALIDDATA;
+            }
+            index = get_bits(&h->gb, 2);
+            wq_model = get_bits(&h->gb, 2);
+            if (index > 2 || wq_model > 2)
+                return AVERROR_INVALIDDATA;
+            base = index == 1 ? wq_base1 : index == 2 ? wq_base2 : wq_default;
+            for (i = 0; i < 6; i++) {
+                const int delta = index ? get_se_golomb(&h->gb) : 0;
+                const int value = base[i] + delta;
+                if (delta < -128 || delta > 127 || value < 0 || value > 255)
+                    return AVERROR_INVALIDDATA;
+                params[i] = value;
+            }
+            for (i = 0; i < 64; i++)
+                h->wq_matrix[h->wq_permutation[i]] = params[model[wq_model][i]];
         }
         h->aec_enable = get_bits1(&h->gb);
     }
