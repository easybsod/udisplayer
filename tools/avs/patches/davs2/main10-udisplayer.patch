diff --git a/source/common/vec/intrinsic_sao_avx2.cc b/source/common/vec/intrinsic_sao_avx2.cc
index 2ad2521..be3d4a6 100644
--- a/source/common/vec/intrinsic_sao_avx2.cc
+++ b/source/common/vec/intrinsic_sao_avx2.cc
@@ -686 +686,97 @@ void SAO_on_block_bo_avx2(pel_t *p_dst, int i_dst,
-#endif // !HIGH_BIT_DEPTH
\ No newline at end of file
+#endif // !HIGH_BIT_DEPTH
+
+#if HIGH_BIT_DEPTH
+/* Process sixteen 10-bit samples at once. AVX2 is dispatched at runtime by
+ * davs2_sao_init; no AVX2 instructions are used on legacy x86-64 CPUs.
+ * Full keyed offsets are essential because the two BO ranges may overlap. */
+void SAO_on_block_bo_avx2_10bit(pel_t *dst, int dst_stride, const pel_t *src,
+                                 int src_stride, int width, int height,
+                                 int bit_depth, const sao_param_t *param)
+{
+    const int shift = bit_depth - NUM_SAO_BO_CLASSES_IN_BIT;
+    const int maxval = (1 << bit_depth) - 1;
+    const int bands[4] = {param->startBand, (param->startBand + 1) & 31,
+                          param->startBand2, (param->startBand2 + 1) & 31};
+    __m256i select[4], offset[4];
+    const __m128i shiftcount = _mm_cvtsi32_si128(shift);
+    const __m256i zero = _mm256_setzero_si256();
+    const __m256i upper = _mm256_set1_epi16((short)maxval);
+    for (int i = 0; i < 4; ++i) {
+        select[i] = _mm256_set1_epi16((short)bands[i]);
+        offset[i] = _mm256_set1_epi16((short)param->offset[bands[i]]);
+    }
+    for (int y = 0; y < height; ++y) {
+        int x = 0;
+        for (; x + 16 <= width; x += 16) {
+            const __m256i pixels = _mm256_loadu_si256((const __m256i *)(src + x));
+            const __m256i bucket = _mm256_srl_epi16(pixels, shiftcount);
+            __m256i correction = zero;
+            for (int i = 0; i < 4; ++i) {
+                correction = _mm256_or_si256(correction,
+                    _mm256_and_si256(_mm256_cmpeq_epi16(bucket, select[i]), offset[i]));
+            }
+            __m256i result = _mm256_adds_epi16(pixels, correction);
+            result = _mm256_max_epi16(zero, _mm256_min_epi16(upper, result));
+            _mm256_storeu_si256((__m256i *)(dst + x), result);
+        }
+        for (; x < width; ++x) {
+            int value = (int)src[x] + param->offset[src[x] >> shift];
+            dst[x] = (pel_t)(value < 0 ? 0 : value > maxval ? maxval : value);
+        }
+        dst += dst_stride;
+        src += src_stride;
+    }
+}
+
+/* Horizontal EO on 16 unsigned 10-bit samples. The reference pixels are in
+ * the separate unfiltered SAO plane, so vector reads cannot see our writes.
+ * Left/right boundary checks are shared with the generic implementation. */
+void SAO_on_block_eo_0_avx2_10bit(pel_t *dst, int dst_stride, const pel_t *src,
+                                   int src_stride, int width, int height,
+                                   int bit_depth, const int *available, const int *offset)
+{
+    const int start_x = available[2] ? 0 : 1;  // SAO_L
+    const int end_x = available[3] ? width : (width - 1);  // SAO_R
+    const int maxval = (1 << bit_depth) - 1;
+    const __m256i plus1 = _mm256_set1_epi16(1);
+    const __m256i plus2 = _mm256_set1_epi16(2);
+    const __m256i zero = _mm256_setzero_si256();
+    const __m256i limit = _mm256_set1_epi16((short)maxval);
+    __m256i classes[5], corrections[5];
+    for (int i = 0; i < 5; ++i) {
+        classes[i] = _mm256_set1_epi16(i);
+        corrections[i] = _mm256_set1_epi16((short)offset[i]);
+    }
+    for (int y = 0; y < height; ++y) {
+        int x = start_x;
+        for (; x + 16 <= end_x; x += 16) {
+            const __m256i left = _mm256_loadu_si256((const __m256i *)(src + x - 1));
+            const __m256i center = _mm256_loadu_si256((const __m256i *)(src + x));
+            const __m256i right = _mm256_loadu_si256((const __m256i *)(src + x + 1));
+            const __m256i positive = _mm256_add_epi16(
+                _mm256_and_si256(_mm256_cmpgt_epi16(center, left), plus1),
+                _mm256_and_si256(_mm256_cmpgt_epi16(center, right), plus1));
+            const __m256i negative = _mm256_add_epi16(
+                _mm256_and_si256(_mm256_cmpgt_epi16(left, center), plus1),
+                _mm256_and_si256(_mm256_cmpgt_epi16(right, center), plus1));
+            const __m256i index = _mm256_add_epi16(plus2, _mm256_sub_epi16(positive, negative));
+            __m256i delta = zero;
+            for (int i = 0; i < 5; ++i)
+                delta = _mm256_or_si256(delta, _mm256_and_si256(
+                    _mm256_cmpeq_epi16(index, classes[i]), corrections[i]));
+            const __m256i sum = _mm256_adds_epi16(center, delta);
+            _mm256_storeu_si256((__m256i *)(dst + x),
+                _mm256_max_epi16(zero, _mm256_min_epi16(limit, sum)));
+        }
+        for (; x < end_x; ++x) {
+            const int center = src[x];
+            const int category = 2 + (center > src[x-1]) - (center < src[x-1])
+                                   + (center > src[x+1]) - (center < src[x+1]);
+            const int sum = center + offset[category];
+            dst[x] = (pel_t)(sum < 0 ? 0 : sum > maxval ? maxval : sum);
+        }
+        src += src_stride;
+        dst += dst_stride;
+    }
+}
+#endif // HIGH_BIT_DEPTH
