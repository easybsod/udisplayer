+    /* Optional, per-decoder AVS2 10-bit non-reference B-picture omission.
+     * Updated under mutex_mgr; bounded to avoid unbounded growth on broken
+     * streams or discontinuous timestamps. */
+    int                 skip_nonref_enabled;
+    unsigned            skipped_poc_count;
+    int                 skipped_pocs[64];
+    uint64_t            skipped_poc_total;
+    uint64_t            skipped_poc_fallbacks;
+
@@ -956,0 +966,3 @@ struct davs2_mgr_t {
+/* Called only while mutex_mgr is held. */
+void davs2_skip_advance_output_locked(davs2_mgr_t *mgr);
+
diff --git a/source/common/davs2.cc b/source/common/davs2.cc
index 1bf99ff..840a9fc 100644
--- a/source/common/davs2.cc
+++ b/source/common/davs2.cc
@@ -243,0 +244,30 @@ int has_new_output_frame(davs2_mgr_t *mgr, davs2_t *h)
+/* Discard old registry entries and consume intentionally omitted POCs.
+ * Caller owns mutex_mgr. Non-reference pictures are never used for future
+ * reconstruction, but their display positions must still advance. */
+void davs2_skip_advance_output_locked(davs2_mgr_t *mgr)
+{
+    unsigned i, write = 0;
+    int advanced;
+
+    if (!mgr->skip_nonref_enabled || mgr->outpics.output < 0)
+        return;
+
+    do {
+        advanced = 0;
+        for (i = 0; i < mgr->skipped_poc_count; i++) {
+            if (mgr->skipped_pocs[i] == mgr->outpics.output) {
+                mgr->outpics.output++;
+                advanced = 1;
+                break;
+            }
+        }
+    } while (advanced);
+
+    /* Keep only POCs that might still be needed after a discontinuity. */
+    for (i = 0; i < mgr->skipped_poc_count; i++) {
+        if (mgr->skipped_pocs[i] >= mgr->outpics.output)
+            mgr->skipped_pocs[write++] = mgr->skipped_pocs[i];
+    }
+    mgr->skipped_poc_count = write;
+}
+
@@ -256,0 +287 @@ davs2_outpic_t *output_list_get_one_output_picture(davs2_mgr_t *mgr)
+        davs2_skip_advance_output_locked(mgr);
@@ -298,0 +330 @@ davs2_outpic_t *output_list_get_one_output_picture(davs2_mgr_t *mgr)
+            davs2_skip_advance_output_locked(mgr);
@@ -449,0 +482 @@ davs2_decoder_open(davs2_param_t *param)
+    const char *skip_env;
@@ -491,0 +525,3 @@ davs2_decoder_open(davs2_param_t *param)
+    /* Disabled unless expressly requested by the caller's environment. */
+    skip_env = getenv("UDISPLAYER_AVS2_SKIP_NONREF");
+    mgr->skip_nonref_enabled = skip_env && strcmp(skip_env, "1") == 0;
@@ -602,0 +639,44 @@ int decoder_decode_es_unit(davs2_mgr_t *mgr, es_unit_t *es_unit)
+        /* Only omit an explicitly non-reference B picture at odd display
+         * POC for verified 10-bit 50/60fps streams. Keep full decoding on
+         * other streams or when the bounded registry is full. */
+        if (mgr->skip_nonref_enabled &&
+            h->seq_info.head.internal_bit_depth == 10 &&
+            h->seq_info.head.frame_rate >= 49.0f &&
+            h->seq_info.head.frame_rate <= 60.5f &&
+            h->i_frame_type == AVS2_B_SLICE &&
+            !h->rps.refered_by_others && (h->i_poc & 1)) {
+            int omit = 0;
+            unsigned i;
+            davs2_thread_mutex_lock(&mgr->mutex_mgr);
+            davs2_skip_advance_output_locked(mgr);
+            if (h->i_poc >= mgr->outpics.output &&
+                mgr->skipped_poc_count < sizeof(mgr->skipped_pocs) / sizeof(mgr->skipped_pocs[0])) {
+                int duplicate = 0;
+                for (i = 0; i < mgr->skipped_poc_count; i++) {
+                    if (mgr->skipped_pocs[i] == h->i_poc) {
+                        duplicate = 1;
+                        break;
+                    }
+                }
+                if (!duplicate) {
+                    mgr->skipped_pocs[mgr->skipped_poc_count++] = h->i_poc;
+                    /* The skipped picture still carries RPS retirement
+                     * commands. Update pending removals before the next header. */
+                    task_apply_pending_removals(mgr);
+                    mgr->num_frames_to_remove = h->rps.num_to_remove;
+                    for (unsigned k = 0; k < (unsigned)h->rps.num_to_remove; k++)
+                        mgr->coi_remove_frame[k] = h->i_coi - h->rps.remove_pic[k];
+                    mgr->skipped_poc_total++;
+                    omit = 1;
+                }
+            }
+            if (!omit)
+                mgr->skipped_poc_fallbacks++;
+            davs2_thread_mutex_unlock(&mgr->mutex_mgr);
+            if (omit) {
+                davs2_thread_mutex_unlock(&mgr->mutex_aec);
+                task_unload_packet(h, es_unit);
+                return 0;
+            }
+        }
+
@@ -785,0 +866,6 @@ davs2_decoder_close(void *decoder)
+    if (mgr->skip_nonref_enabled)
+        davs2_log(mgr, DAVS2_LOG_INFO,
+                  "non-reference B-frame omissions: %llu, fallbacks: %llu",
+                  (unsigned long long)mgr->skipped_poc_total,
+                  (unsigned long long)mgr->skipped_poc_fallbacks);
+
