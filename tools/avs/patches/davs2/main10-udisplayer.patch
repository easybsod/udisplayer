@@ -162,0 +163,36 @@ void output_decoded_frame(davs2_picture_t *pic, davs2_seq_info_t *headerset, int
+    if (getenv("UDISPLAYER_AVS2_TEST_HASH") != NULL) {
+        unsigned long long h = 1469598103934665603ULL;
+        int y, x;
+        for (y = 0; y < pic->lines[0]; y += 89) {
+            const unsigned char *row = pic->planes[0] + (long long)y * pic->strides[0];
+            for (x = 0; x < pic->widths[0]; x += 97) {
+                unsigned int v;
+                if (pic->bytes_per_sample == 2) v = ((const unsigned short *)row)[x];
+                else v = row[x];
+                h = (h ^ v) * 1099511628211ULL;
+            }
+        }
+        fprintf(stderr, "UDISPLAYER_AVS2_SAMPLE_HASH poc=%d type=%d hash=%016llx\n", pic->pic_order_count, pic->type, h);
+    }
+    if (getenv("UDISPLAYER_AVS2_FULL_HASH") != NULL) {
+        /* Hash every visible byte of every plane; never include row padding. */
+        unsigned long long h = 1469598103934665603ULL;
+        int plane, line, x;
+        for (plane = 0; plane < pic->num_planes; plane++) {
+            const int row_bytes = pic->widths[plane] * pic->bytes_per_sample;
+            for (line = 0; line < pic->lines[plane]; line++) {
+                const unsigned char *row = pic->planes[plane] +
+                    (long long)line * pic->strides[plane];
+                for (x = 0; x + 8 <= row_bytes; x += 8) {
+                    unsigned long long word;
+                    memcpy(&word, row + x, sizeof(word));
+                    h = (h ^ word) * 1099511628211ULL;
+                }
+                for (; x < row_bytes; x++) {
+                    h = (h ^ row[x]) * 1099511628211ULL;
+                }
+            }
+        }
+        fprintf(stderr, "UDISPLAYER_AVS2_FULL_HASH poc=%d type=%d hash=%016llx\n",
+                pic->pic_order_count, pic->type, h);
+    }
